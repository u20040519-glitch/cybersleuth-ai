# =============================================================================
# PROJECT NEXUS AI - Environment Configuration
# =============================================================================
# COPY THIS FILE TO .env AND FILL IN ACTUAL VALUES FOR LOCAL DEVELOPMENT
# NEVER COMMIT .env TO VERSION CONTROL
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-secure-random-secret-at-least-32-chars
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL production / SQLite development) ---
DATABASE_URL=postgresql+asyncpg://nexus_user:nexus_password@localhost:5432/nexus_ai
# For local SQLite development: DATABASE_URL=sqlite+aiosqlite:///./nexus_ai.db

# --- Security / Authentication ---
ARGON2ID_MEMORY_COST=65536
ARGON2ID_TIME_COST=3
ARGON2ID_PARALLELISM=4
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_COOKIE_NAME=nexus_session
SESSION_COOKIE_SECURE=false   # set true in production (HTTPS only)
SESSION_COOKIE_SAMESITE=lax

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="PROJECT NEXUS AI"
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# --- Gemini AI (backend only - never expose to frontend) ---
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# --- Rate Limiting (Redis) ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_MIN=3
RATE_LIMIT_PASSWORD_RESET_PER_MIN=3
RATE_LIMIT_EMAIL_VERIFY_PER_MIN=3
RATE_LIMIT_CHATBOT_PER_MIN=20
RATE_LIMIT_REPORT_PER_MIN=5
RATE_LIMIT_UPLOAD_PER_MIN=10

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=pdf,docx,txt,json,csv,png,jpg,jpeg,tiff
UPLOAD_DIRECTORY=./uploads

# --- Analytics (privacy-conscious) ---
ANALYTICS_PROVIDER=none   # none | plausible | posthog | custom
ANALYTICS_WRITE_KEY=change-me
ANALYTICS_API_URL=https://analytics.example.com

# --- Error Tracking (Sentry) ---
SENTRY_DSN=change-me
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0

# --- Storage ---
STORAGE_PROVIDER=local    # local | s3 | gcs
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_S3_BUCKET=nexus-ai-storage
AWS_S3_REGION=us-east-1

# --- Backups ---
BACKUP_ENCRYPTION_KEY=change-me-32-chars-min
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_CRON=0 2 * * *

# --- Organization / Legal (PLACEHOLDERS - replace before launch) ---
ORG_NAME=PROJECT NEXUS AI (Academic Project)
ORG_ADDRESS=
ORG_SUPPORT_EMAIL=support@example.com
ORG_PRIVACY_EMAIL=privacy@example.com
ORG_WEBSITE=https://example.com
ORG_LEGAL_ENTITY=Academic / Student Project
POLICY_VERSION=1.0.0
POLICY_EFFECTIVE_DATE=2026-11-13

# --- Security Features ---
MFA_ENABLED=false
REGISTRATION_EMAIL_VERIFICATION_REQUIRED=true
ACCOUNT_DELETION_GRACE_PERIOD_DAYS=7

# =============================================================================
# END OF ENVIRONMENT CONFIGURATION
# =============================================================================