# =============================================================================
# CYBERSLEUTH AI - Environment Configuration
# =============================================================================
# COPY THIS FILE TO .env AND FILL IN ACTUAL VALUES FOR LOCAL DEVELOPMENT
# NEVER COMMIT .env TO VERSION CONTROL
# NEVER PUT REAL API KEYS IN SOURCE CODE, DOCUMENTATION, OR GIT HISTORY
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-secure-random-secret-at-least-32-chars
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Supabase (Authentication, Database, Storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key  # backend only

# --- Google Gemini AI (backend only - NEVER expose to frontend) ---
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-1.5-flash

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000/api

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,mp4,mov,avi,mkv,wav,mp3,flac,m4a,pdf,docx,txt,json,csv,xml,eml,apk
UPLOAD_DIRECTORY=./uploads

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cybersleuth_ai

# =============================================================================
# END OF ENVIRONMENT CONFIGURATION
# =============================================================================
