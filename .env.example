# =============================================================================
# CYBERSLEUTH AI - Combined environment template (frontend + backend)
# =============================================================================
# This file documents every variable the project uses. In practice you run
# with two files:
#   backend/.env    - backend/.env.example is the authoritative API template
#   frontend/.env   - frontend/.env.example holds the VITE_* variables
# Copy values from this file or those; never commit any real .env.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-secure-random-secret-at-least-32-chars
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL) ---------------------------------------------------
# Local dev: leave both unset -> embedded PostgreSQL under backend/.pgdata.
# Production: privileged URL for migrations only + restricted runtime role.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cybersleuth_ai
APP_DATABASE_URL=postgresql+asyncpg://cybersleuth_app:change-me@localhost:5432/cybersleuth_ai
APP_DB_USER=cybersleuth_app
APP_DB_PASSWORD=change-me

# --- Supabase (Authentication, Database, Storage) -----------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key  # backend only

# --- Google Gemini AI (backend only - NEVER expose to frontend) --------------
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-3.5-flash

# --- Frontend (Vite) ---------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000/api

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=apk,csv,docx,jpeg,jpg,json,m4a,mov,mp3,mp4,pdf,png,txt,wav
UPLOAD_DIRECTORY=./storage
STORAGE_BACKEND=local

# =============================================================================
# END OF ENVIRONMENT CONFIGURATION
# =============================================================================
