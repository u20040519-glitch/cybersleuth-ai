{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install frontend dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run frontend dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "file": "tsconfig.json",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*ready in.*",
          "endsPattern": ".*Local:.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Build frontend for production",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "CyberSleuth: install backend dependencies",
      "detail": "Installs backend/requirements-dev.txt (production requirements + the development-only embedded PostgreSQL)",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pip install -r backend/requirements-dev.txt",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Install all dependencies",
      "detail": "Backend (pip) and frontend (npm) dependencies - run once on a fresh clone",
      "type": "shell",
      "command": "echo Installing backend and frontend dependencies",
      "dependsOn": [
        "CyberSleuth: install backend dependencies",
        "Install frontend dependencies"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CyberSleuth: start API",
      "detail": "uvicorn app.main:app on http://127.0.0.1:8000 (embedded PostgreSQL is provisioned on first start)",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PYTHONUNBUFFERED": "1"
        }
      },
      "dependsOn": ["CyberSleuth: install backend dependencies"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "shell",
        "pattern": {
          "regexp": "^(E\\s{2,}(.*)|Traceback \\(most recent call last\\))$",
          "file": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Uvicorn running|Started server process).*",
          "endsPattern": ".*(Application startup complete|Waiting for application startup).*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "CyberSleuth: start frontend",
      "detail": "Vite dev server on http://localhost:3000 (proxies /api to the API on port 8000)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "dependsOn": ["Install frontend dependencies"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "file": "tsconfig.json",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*ready in.*",
          "endsPattern": ".*Local:.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CyberSleuth: start full stack",
      "detail": "API (8000) + frontend (3000) together - installs the dependencies first so it also works on a fresh clone",
      "type": "shell",
      "command": "echo CyberSleuth AI is starting: API on http://127.0.0.1:8000, UI on http://localhost:3000",
      "dependsOn": [
        "CyberSleuth: install backend dependencies",
        "Install frontend dependencies",
        "CyberSleuth: start API",
        "CyberSleuth: start frontend"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CyberSleuth: run backend tests",
      "detail": "pytest against the isolated cybersleuth_test database",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest -q",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CyberSleuth: typecheck frontend",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CyberSleuth: lint frontend",
      "detail": "ESLint over frontend/src (--max-warnings 0)",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CyberSleuth: reset dev database",
      "detail": "Drops and rebuilds the local schema from supabase/migrations (refuses to run against a non-local database)",
      "type": "shell",
      "command": "${command:python.interpreterPath} scripts/reset_dev_db.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CyberSleuth: build docker images",
      "detail": "Builds the API and the frontend image from the repository root context",
      "type": "shell",
      "command": "docker build -t cybersleuth-api -f backend/Dockerfile . && docker build -t cybersleuth-frontend -f frontend/Dockerfile .",
      "windows": {
        "command": "cmd /c \"docker build -t cybersleuth-api -f backend/Dockerfile . && docker build -t cybersleuth-frontend -f frontend/Dockerfile .\""
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CyberSleuth: seed demo data",
      "detail": "Recreate the Operation Silent Whisper case (idempotent)",
      "type": "shell",
      "command": "${command:python.interpreterPath} scripts/seed_demo_data.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": ["CyberSleuth: start API"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CyberSleuth: generate scratch evidence",
      "detail": "Synthesises the demo evidence files in scratch-evidence/ (does not overwrite existing files)",
      "type": "shell",
      "command": "${command:python.interpreterPath} scripts/generate_scratch_evidence.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
