# =============================================================================
# CYBERSLEUTH AI - .gitignore
# =============================================================================

# Environment variables (SECRETS - never commit)
.env
.env.local
.env.*.local
.envrc
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pipenv/
.python-version

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints

# Streamlit
.streamlit/secrets.toml

# IDE
# Editor-local state stays out of the repo, but the shared run configurations
# (tasks.json / launch.json) are committed so anyone can start the project
# from VS Code with one click.
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Backend
instance/
.webassets-cache

# Database
*.sqlite
*.sqlite3
db.sqlite3
db.sqlite3-journal
*.rdb
*.aof

# Frontend
node_modules/
frontend/dist/
frontend/build/
.next/
.nuxt/
dist/
build/

# Backups (never commit backups containing data)
backups/*.sql
backups/*.encrypted
backups/*.dump

# Misc
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.cython_debug/
.ruff_cache/
.poetry.lock
poetry.toml

# Backups (never commit backups containing data)
backups/*.sql
backups/*.encrypted
backups/*.dump
backups/*.db
backups/backup_manifest.json

# Database files
*.db
*.sqlite
*.sqlite3
db.sqlite3
db.sqlite3-journal

# Docker
.env
.env.production
frontend/dist/
frontend/build/

# End of file

# =============================================================================
# CyberSleuth AI - Evidence & forensic artefacts
# =============================================================================
# Never commit real evidence, extracted frames, or generated reports.
uploads/
backend/uploads/
evidence/
backend/evidence/
backend/storage/
*.apk
*.apks

# Vite config timestamp artefacts (generated on every dev-server reload)
vite.config.js.timestamp-*.mjs
vite.config.mjs.timestamp-*.mjs
vite.config.cjs.timestamp-*.mjs
vite.config.ts.timestamp-*.mjs
vite.config.mts.timestamp-*.mjs
vite.config.cts.timestamp-*.mjs
vitest.config.js.timestamp-*.mjs
vitest.config.mjs.timestamp-*.mjs
vitest.config.cjs.timestamp-*.mjs
vitest.config.ts.timestamp-*.mjs
vitest.config.mts.timestamp-*.mjs
vitest.config.cts.timestamp-*.mjs

